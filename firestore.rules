// Règles de sécurité Firestore — à coller dans la console Firebase → Firestore → Règles.
// Nécessite la vraie authentification Firebase (custom tokens via /api/otp) :
// request.auth.uid = numéro de téléphone de l'utilisateur.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function connecte() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/utilisateurs/$(request.auth.uid)).data.role;
    }

    function estAdmin() {
      return connecte() && role() == "admin";
    }

    // Agent municipal : traite les signalements d'insalubrité, y compris ceux
    // qui visent une personne (transmis à la police municipale).
    function estMairie() {
      return connecte() && role() == "mairie";
    }

    // Signalements : lecture publique (page d'accueil), écritures contrôlées
    match /signalements/{id} {
      allow read: if true;
      allow create: if connecte() && request.resource.data.uid == request.auth.uid;
      allow update: if connecte() && (
        resource.data.uid == request.auth.uid
        || (resource.data.status == "disponible" && request.resource.data.collecteurId == request.auth.uid)
        || resource.data.collecteurId == request.auth.uid
        || estAdmin()
      );
      // Tout collecteur connecté peut incrémenter/décrémenter le compteur de corbeilles (seul champ modifiable)
      allow update: if connecte()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["corbeillesCount"]);
      allow delete: if connecte() && (resource.data.uid == request.auth.uid || estAdmin());
    }

    // Profils : chacun le sien ; l'admin voit et gère tout.
    // Un utilisateur ne peut pas s'auto-attribuer le rôle admin.
    match /utilisateurs/{uid} {
      allow get: if connecte() && (request.auth.uid == uid || estAdmin());
      allow list: if estAdmin();
      allow create, update: if connecte() && request.auth.uid == uid
        && request.resource.data.role in ["menage", "collecteur"];
      allow update: if estAdmin();
      allow delete: if estAdmin();
    }

    // Corbeilles (brouillons) : chaque collecteur gère uniquement les siennes
    match /corbeilles/{id} {
      allow read, delete: if connecte() && resource.data.collecteurId == request.auth.uid;
      allow create: if connecte() && request.resource.data.collecteurId == request.auth.uid;
    }

    // Positions temps réel : écrites par le collecteur lui-même, lues par les connectés
    match /positions/{uid} {
      allow read: if connecte();
      allow write: if connecte() && request.auth.uid == uid;
    }

    // Bornes connectées : lecture publique (la carte les affiche à tous),
    // écriture réservée au serveur — c'est /api/borne, authentifié par la clé
    // de chaque borne, qui met à jour poids et remplissage.
    match /bornes/{code} {
      allow read: if true;
      allow write: if false;
    }

    // Dépôts, vidages et compteurs journaliers : écrits par /api/borne via
    // l'admin SDK, qui ignore ces règles. Aucun accès depuis le navigateur.
    // Seul l'admin peut les relire, pour le suivi et l'audit des fraudes.
    match /depots/{id} {
      allow read: if estAdmin();
      allow write: if false;
    }

    match /vidages/{id} {
      allow read: if estAdmin();
      allow write: if false;
    }

    match /compteurs/{id} {
      allow read, write: if false;
    }

    // Signalements citoyens d'insalubrité.
    // Le problème est public, la personne ne l'est jamais : seuls les incidents
    // marqués « publique » sont lisibles par tous. Les signalements qui visent
    // un individu (visibilite == "restreinte") ne sont accessibles qu'à leur
    // auteur et à l'admin.
    match /incidents/{id} {
      allow read: if resource.data.visibilite == "publique"
        || (connecte() && resource.data.uid == request.auth.uid)
        || estMairie() || estAdmin();

      allow create: if connecte()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.statut == "signale"
        && request.resource.data.visibilite in ["publique", "restreinte"];

      // Un citoyen ne peut que confirmer (« c'est toujours là ») : il ajoute sa
      // confirmation, sans rien pouvoir changer d'autre.
      allow update: if connecte()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["confirmations", "confirmePar", "derniereConfirmationAt"]);

      // L'auteur peut retirer son signalement tant qu'il n'est pas pris en charge.
      allow delete: if connecte()
        && (estAdmin() || (resource.data.uid == request.auth.uid && resource.data.statut == "signale"));

      // Le traitement — affectation à un service, avancement du statut,
      // preuve de résolution — est réservé à la mairie et à l'admin.
      allow update: if estMairie() || estAdmin();
    }

    // Codes OTP : réservés au serveur (admin SDK, qui ignore les règles)
    match /otps/{tel} {
      allow read, write: if false;
    }
  }
}
